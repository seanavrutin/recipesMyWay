# Copy the values you need into server/.env. That file is gitignored.

# ── Required ──────────────────────────────────────────────────────────────────
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── AI model (optional) ───────────────────────────────────────────────────────
# Defaults to gemini-3.5-flash, a stable release with a long support window.
# gemini-3.5-flash-lite is cheaper and faster; gemini-3.7-flash is newer but is
# published as a short-term-availability model, so it needs revisiting sooner.
GEMINI_MODEL=gemini-3.5-flash
# How long to wait for the model before giving up, in milliseconds.
GEMINI_TIMEOUT_MS=90000
# Output token ceiling per recipe. Gemini 3.x spends part of it on internal reasoning, so raise
# this if the logs start showing AI_TRUNCATED_RESPONSE on long recipes.
GEMINI_MAX_OUTPUT_TOKENS=8192

# ── Logging (optional) ────────────────────────────────────────────────────────
# debug | info | warn | error. Defaults to debug outside production, info in it.
LOG_LEVEL=info
# pretty (default, human readable) or json (one object per line, for log tooling).
LOG_FORMAT=pretty
# 1 forces ANSI colour, 0 disables it. Default: colour only on a real terminal.
LOG_COLOR=
# 1 sends warn/error to stderr. Default keeps every level on stdout so that
# multi-line error blocks cannot be split apart by stream interleaving.
LOG_STDERR=

# ── Server (optional) ─────────────────────────────────────────────────────────
PORT=3000
# Comma-separated extra origins, added to the built-in allow list.
CORS_ALLOWED_ORIGINS=

# ── Firestore credentials (pick one) ──────────────────────────────────────────
# Either the service account JSON inline...
FIREBASE_SERVICE_ACCOUNT=
# ...or a path to the key file.
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/firebase-service-account.json

# ── Scraping (optional) ───────────────────────────────────────────────────────
SCRAPE_TIMEOUT_MS=20000
SCRAPE_MAX_CHARS=60000
MAX_IMAGE_BYTES=15728640

# ── WhatsApp webhook (optional, only for the WhatsApp entry point) ────────────
PHONE_NUMBER_ID=
ACCESS_TOKEN=
VERIFY_TOKEN=

# ── Backup (optional) ─────────────────────────────────────────────────────────
BACKUP_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_PATH=./credentials.json
