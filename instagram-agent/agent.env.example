# Copy to ~/.config/instagram-agent/agent.env on VM 102 and `chmod 600` it.
# No quotes around values (systemd EnvironmentFile syntax).

# The dedicated recipes Instagram account.
IG_USERNAME=
IG_PASSWORD=

# The account's Gmail, read over IMAP for Instagram's emailed security codes.
# Needs 2-Step Verification on the Google account, then an app password from
# https://myaccount.google.com/apppasswords (16 letters, spaces removed).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Must equal INSTAGRAM_AGENT_TOKEN in the server's server/.env.
INSTAGRAM_AGENT_TOKEN=
# LAN address on purpose: /agent routes refuse anything that came through the Cloudflare tunnel.
RECIPES_API_URL=http://10.0.0.41:3000

# Optional: Home Assistant webhook that turns the alert into a phone notification.
# Receives JSON {title, message}.
ALERT_WEBHOOK_URL=
